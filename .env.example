# ==========================================
# Face ID + Blockchain Verification Pipeline
# Configuration Environment Variables
# ==========================================

# ------------------------------------------
# 1. Reverse-Image Search Provider
# ------------------------------------------
# Provider options: 'serpapi', 'serper', or 'scraper'
SEARCH_PROVIDER=serpapi

# SerpApi API key (Get a free key at https://serpapi.com with 100 free searches/month)
SERPAPI_API_KEY=

# Alternative: Serper.dev API key (Get a free key at https://serper.dev)
SERPER_API_KEY=

# ------------------------------------------
# 2. Blockchain Settings (EVM / Polygon Amoy / Sepolia)
# ------------------------------------------
# Network choice: 'polygon_amoy', 'sepolia', or 'simulator'
BLOCKCHAIN_NETWORK=polygon_amoy

# RPC Endpoints (defaults provided, can override with Alchemy / Infura / QuickNode)
POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Wallet Private Key (optional - if omitted, an ephemeral wallet will be generated)
# Note: For public testnet transactions, the wallet must have testnet gas tokens (Amoy POL or Sepolia ETH)
# Faucet for Polygon Amoy: https://faucet.polygon.technology/
# Faucet for Sepolia: https://cloud.google.com/application/faucets/ethereum/sepolia
WALLET_PRIVATE_KEY=

# Optional: Smart Contract Address (if interacting with custom registry)
CONTRACT_ADDRESS=

# ------------------------------------------
# 3. Pipeline Parameters
# ------------------------------------------
MIN_FACE_CONFIDENCE=0.60
SIMILARITY_THRESHOLD=0.75
OUTPUT_DIR=output
